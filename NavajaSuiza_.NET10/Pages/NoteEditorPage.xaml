<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NavajaSuiza_.NET10.Converters"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Name="NoteEditorPageRoot"
             x:Class="NavajaSuiza_.NET10.Pages.NoteEditorPage"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="12"
              Padding="20">

            <!-- Título: siempre al principio -->
            <Entry Grid.Row="0"
                   Text="{Binding TitleText}"
                   Placeholder="{extensions:Translate NotesTitlePlaceholderText}"
                   FontAttributes="Bold"
                   FontSize="18"
                   BackgroundColor="Transparent" />

            <!-- Área de texto: crece con el contenido, empuja las acciones hacia abajo -->
            <Editor Grid.Row="1"
                    Text="{Binding ContentText}"
                    Placeholder="{extensions:Translate NotesContentPlaceholderText}"
                    AutoSize="TextChanges"
                    VerticalOptions="Start"
                    BackgroundColor="Transparent" />

            <!-- Acciones: recordatorio + botón, al final -->
            <VerticalStackLayout Grid.Row="2" Spacing="8">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{extensions:Translate NotesReminderSectionText}"
                           FontSize="14"
                           Opacity="0.8"
                           VerticalOptions="Center" />

                    <Switch Grid.Column="1"
                            IsToggled="{Binding HasReminder}"
                            OnColor="{StaticResource MyAccentBlue}" />
                </Grid>

                <HorizontalStackLayout IsVisible="{Binding HasReminder}" Spacing="8">
                    <DatePicker Date="{Binding ReminderDate}"
                                FontSize="14"
                                VerticalOptions="Center" />

                    <TimePicker Time="{Binding ReminderTime}"
                                FontSize="14"
                                VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="{extensions:Translate NotesSaveText}"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="48"
                        CornerRadius="12"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>