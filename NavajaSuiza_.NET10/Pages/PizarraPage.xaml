<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.PizarraPage"
             Title="{extensions:Translate PizarraText}">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <ScrollView
            Grid.Row="0"
            Orientation="Horizontal">

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Padding="10,5"
                Spacing="20">

                <VerticalStackLayout Spacing="5">
                    <Label HorizontalOptions="Center" Text="{extensions:Translate PizarraClearText}" />
                    <Button
                        Command="{Binding ClearCommand}"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        ImageSource="icon_delete.png"
                        FontAttributes="Bold"
                        ContentLayout="Top, 0"
                        Padding="5"
                        WidthRequest="50"
                        HeightRequest="50"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label HorizontalOptions="Center" Text="{extensions:Translate PizarraUndoText}" />
                    <Button
                        Command="{Binding UndoCommand}"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        ImageSource="icon_erase.png"
                        FontAttributes="Bold"
                        ContentLayout="Top, 0"
                        Padding="5"
                        WidthRequest="50"
                        HeightRequest="50"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label HorizontalOptions="Center" Text="{extensions:Translate PizarraColorsText}" />
                    <Button
                        Command="{Binding OpenColorPickerCommand}"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        ImageSource="icon_palette.png"
                        FontAttributes="Bold"
                        ContentLayout="Top, 0"
                        Padding="5"
                        WidthRequest="50"
                        HeightRequest="50"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label HorizontalOptions="Center" Text="{extensions:Translate PizarraBoardShortText}" />
                    <Button
                        Clicked="OnBoardClicked"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        ImageSource="icon_blackboard.png"
                        FontAttributes="Bold"
                        ContentLayout="Top, 0"
                        Padding="5"
                        WidthRequest="50"
                        HeightRequest="50"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label HorizontalOptions="Center" Text="{extensions:Translate PizarraSaveText}" />
                    <Button
                        Clicked="OnSaveClicked"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        ImageSource="icon_save.png"
                        FontAttributes="Bold"
                        ContentLayout="Top, 0"
                        Padding="5"
                        WidthRequest="50"
                        HeightRequest="50"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

