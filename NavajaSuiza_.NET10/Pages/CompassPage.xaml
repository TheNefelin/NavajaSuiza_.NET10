<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             xmlns:converters="clr-namespace:NavajaSuiza_.NET10.Converters"
             x:Class="NavajaSuiza_.NET10.Pages.CompassPage"
             Title="{extensions:Translate CompassText}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout 
            Padding="0,20"
            Spacing="20">

            <!-- DIAL DE LA BRÚJULA (GIRA) -->
            <Grid 
                x:Name="CompassDial"
                HeightRequest="300"
                WidthRequest="300"
                Rotation="{Binding CompassDialRotation}">

                <Line X1="0" X2="300"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="5" Stroke="Red" />

                <Line Y1="0" Y2="300"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="5" Stroke="Red" />

                <Ellipse 
                    Stroke="{StaticResource MyAccentBlue}"
                    StrokeThickness="3"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource MyBackgroundMenuDark}, Light={StaticResource MyBackgroundMenuLight}}"
                    WidthRequest="270" HeightRequest="270"
                    HorizontalOptions="Center" VerticalOptions="Center" />

                <Line X1="0" X2="150"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="5" Stroke="Red" />

                <Line Y1="0" Y2="150"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="5" Stroke="Red" />

                <!-- Puntos cardinales -->
                <Grid>
                    <Label Text="{extensions:Translate CompassCardinalNText}" FontSize="24" FontAttributes="Bold"
                        TextColor="#FF3B30" Margin="0,30,0,0"
                        HorizontalOptions="Center" VerticalOptions="Start" />
                    <Label Text="{extensions:Translate CompassCardinalEText}" FontSize="24" FontAttributes="Bold"
                        TextColor="#34C759" Margin="0,0,30,0"
                        HorizontalOptions="End" VerticalOptions="Center" />
                    <Label Text="{extensions:Translate CompassCardinalSText}" FontSize="24" FontAttributes="Bold"
                        TextColor="#007AFF" Margin="0,0,0,30"
                        HorizontalOptions="Center" VerticalOptions="End" />
                    <Label Text="{extensions:Translate CompassCardinalWText}" FontSize="24" FontAttributes="Bold"
                        TextColor="#FF9500" Margin="30,0,0,0"
                        HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>

                <!-- Marcas intermedias -->
                <Grid>
                    <Label Text="•" FontSize="20"
                        VerticalOptions="Start" HorizontalOptions="End"
                        Margin="0,70,70,0" />
                    <Label Text="•" FontSize="20"
                        VerticalOptions="End" HorizontalOptions="End"
                        Margin="0,0,70,70" />
                    <Label Text="•" FontSize="20"
                        VerticalOptions="End" HorizontalOptions="Start"
                        Margin="70,0,0,70" />
                    <Label Text="•" FontSize="20"
                        VerticalOptions="Start" HorizontalOptions="Start"
                        Margin="70,70,0,0" />
                </Grid>

                <!-- Indicador numérico central -->
                <Border
                    BackgroundColor="{StaticResource MyBackground}"
                    StrokeShape="Ellipse"
                    StrokeThickness="1"
                    WidthRequest="100"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label 
                        Text="{Binding AngleText}" 
                        FontSize="28" 
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <!-- Indicador de estado -->
            <Label Text="{Binding StatusText}" FontSize="16" HorizontalOptions="Center" />

            <!-- Dirección cardinal -->
            <Border 
                BackgroundColor="{AppThemeBinding Dark={StaticResource MyPrimaryDark}, Light={StaticResource MyPrimaryLight}}"
                StrokeShape="10" Padding="15" Margin="20,0">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{extensions:Translate CompassCardinalAddressText}" FontSize="12" 
                        HorizontalOptions="Center" />
                    <Label Text="{Binding CardinalDirection}" FontSize="24" 
                        FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Mi posición -->
            <Label 
                Text="{extensions:Translate CompassPositionText}"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Margin="20,0,20,0" />

            <Button 
                Text="{extensions:Translate CompassLocateButtonText}"
                Command="{Binding LocateCommand}"
                IsEnabled="{Binding IsLocating, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="{StaticResource MyAccentBlue}"
                TextColor="White"
                FontSize="16"
                HeightRequest="50"
                Margin="20,0"
                HorizontalOptions="Fill" />

            <Label 
                Text="{Binding PositionMessage}"
                IsVisible="{Binding PositionMessage, Converter={StaticResource StringNotEmptyConverter}}"
                HorizontalTextAlignment="Center"
                FontSize="13"
                Opacity="0.7"
                Margin="20,0,20,10">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsLocationDisabledMessage}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter
                            Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource MyDangerLight}, Dark={StaticResource MyDangerDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Grid 
                IsVisible="{Binding HasPosition}"
                Margin="20,0"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,*,Auto,*"
                ColumnSpacing="10"
                RowSpacing="8">

                <Label Grid.Row="0" Grid.Column="0" Text="{extensions:Translate CompassLatitudeText}" FontSize="13" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding LatitudeText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="2" Text="{extensions:Translate CompassLongitudeText}" FontSize="13" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="3" Text="{Binding LongitudeText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="{extensions:Translate CompassAltitudeText}" FontSize="13" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding AltitudeText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="2" Text="{extensions:Translate CompassAccuracyText}" FontSize="13" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="3" Text="{Binding AccuracyText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <!-- Botón Calibrar -->
            <Button 
                Text="{extensions:Translate CompassCalibrateButtonText}"
                Command="{Binding CalibrateCommand}"
                IsEnabled="{Binding IsCalibrating, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="{StaticResource MyAccentBlue}"
                TextColor="White"
                FontSize="16"
                HeightRequest="50"
                Margin="20,0"
                HorizontalOptions="Fill" />

            <Label 
                Text="{Binding CalibrationText}"
                IsVisible="{Binding IsCalibrating}"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource MyAccentBlue}"
                Margin="20,0,20,10"/>

            <Label 
                Text="{extensions:Translate CompassAdviceText}"
                HorizontalTextAlignment="Center"
                Opacity="0.6" 
                Padding="10"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
