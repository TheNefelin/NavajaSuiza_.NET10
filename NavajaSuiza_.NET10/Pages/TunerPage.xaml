<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             xmlns:converters="clr-namespace:NavajaSuiza_.NET10.Converters"
             x:Class="NavajaSuiza_.NET10.Pages.TunerPage"
             Title="{extensions:Translate TunerText}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout 
            HorizontalOptions="Center" 
            Padding="0,20">

            <Label 
                Text="{extensions:Translate TunerOptionsText}"
                HorizontalTextAlignment="Center"
                Opacity="0.6" 
                Padding="10"/>

            <FlexLayout
                Wrap="Wrap"
                JustifyContent="Center"
                Padding="0,20">

                <Button
                    Text="{extensions:Translate TunerNylonText}"
                    Command="{Binding NavigateToNylonCommand}"
                    ImageSource="instrument_gn.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="{extensions:Translate TunerSteelText}"
                    Command="{Binding NavigateToSteelCommand}"
                    ImageSource="instrument_gs.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="{extensions:Translate TunerBassText}"
                    Command="{Binding NavigateToBassCommand}"
                    ImageSource="instrument_b.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="{extensions:Translate TunerUkeleleText}"
                    Command="{Binding NavigateToUkeleleCommand}"
                    ImageSource="instrument_u.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="{extensions:Translate TunerViolinText}"
                    Command="{Binding NavigateToViolinCommand}"
                    ImageSource="instrument_v.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="{extensions:Translate TunerCharangoText}"
                    Command="{Binding NavigateToCharangoCommand}"
                    ImageSource="instrument_c.png"
                    FontAttributes="Bold"
                    FontSize="12"
                    ContentLayout="Top, 0" 
                    Margin="8,5"
                    Padding="25,15"
                    WidthRequest="130" 
                    HeightRequest="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
