<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.StopwatchPage"
             x:Name="StopwatchPageRoot"
             Title="{extensions:Translate StopwatchText}">

    <ScrollView>
        <VerticalStackLayout
            Padding="0,15"
            Spacing="30">

            <Label
                Text="{extensions:Translate StopwatchElapsedText}"
                HorizontalTextAlignment="Center"
                Opacity="0.6"
                Padding="10" />

            <Border
                Padding="0,20"
                Margin="20,0"
                StrokeThickness="2"
                Stroke="{StaticResource MyAccentBlue}"
                StrokeShape="RoundRectangle 20">

                <Label
                    Text="{Binding ElapsedText}"
                    FontSize="40"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource MyAccentBlue}" />
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="40" Padding="10">

                <Button
                    Command="{Binding StartLapCommand}"
                    ImageSource="icon_play.png"
                    WidthRequest="120"
                    HeightRequest="120" />

                <Button
                    Command="{Binding StopResetCommand}"
                    ImageSource="icon_stop.png"
                    WidthRequest="120"
                    HeightRequest="120" />
            </HorizontalStackLayout>

            <VerticalStackLayout Padding="20,0" Spacing="6">
                <Label
                    Text="{extensions:Translate LapText}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Opacity="0.7" />

                <VerticalStackLayout
                    Spacing="2"
                    BindableLayout.ItemsSource="{Binding Laps}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                ColumnDefinitions="Auto,*,*,Auto"
                                ColumnSpacing="10"
                                Padding="6,4"
                                BackgroundColor="{AppThemeBinding Light={StaticResource MyPrimaryLight}, Dark={StaticResource MyPrimaryDark}}">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Number}"
                                    FontSize="14"
                                    WidthRequest="30"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"                                    
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"                                    
                                    Text="{Binding SplitText}"
                                    FontSize="14"
                                    TextColor="{StaticResource MyAccentBlue}"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding DeltaText}"
                                    FontSize="13"
                                    Opacity="0.7"
                                    HorizontalTextAlignment="Center"                                    
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="3"
                                    Command="{Binding BindingContext.DeleteLapCommand, Source={x:Reference StopwatchPageRoot}}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource MyOn}"
                                    ImageSource="icon_delete.png"
                                    Padding="10"
                                    WidthRequest="44"
                                    HeightRequest="44" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
