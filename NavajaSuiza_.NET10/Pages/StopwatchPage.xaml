<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.StopwatchPage"
             Title="{extensions:Translate StopwatchText}">

    <ScrollView>
        <VerticalStackLayout
            Padding="0,20"
            Spacing="30">

            <Label
                Text="{extensions:Translate StopwatchElapsedText}"
                HorizontalTextAlignment="Center"
                Opacity="0.6"
                Padding="10" />

            <Border
                Padding="20"
                Margin="30,0"
                StrokeThickness="2"
                Stroke="{StaticResource MyAccentBlue}"
                StrokeShape="RoundRectangle 20">

                <Label
                    Text="{Binding ElapsedText}"
                    FontSize="40"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource MyAccentBlue}" />
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="40" Padding="10">

                <Button
                    Command="{Binding StartLapCommand}"
                    ImageSource="icon_play.png"
                    WidthRequest="120"
                    HeightRequest="120" />

                <Button
                    Command="{Binding StopResetCommand}"
                    ImageSource="icon_stop.png"
                    WidthRequest="120"
                    HeightRequest="120" />
            </HorizontalStackLayout>

            <VerticalStackLayout Padding="20,0" Spacing="6">

                <Label
                    Text="{extensions:Translate LapText}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Opacity="0.7" />

                <Border
                    Padding="10"
                    StrokeThickness="1"
                    Stroke="{StaticResource MyAccentBlue}"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout
                        Spacing="2"
                        BindableLayout.ItemsSource="{Binding Laps}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="6,4">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Number}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding SplitText}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource MyAccentBlue}"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding DeltaText}"
                                        FontSize="13"
                                        Opacity="0.7"
                                        VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>