<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.AboutPage"
             Title="{extensions:Translate AboutText}">

    <ScrollView>
        <Grid 
            RowDefinitions="*,auto,auto" 
            RowSpacing="20"
            Padding="20">

            <Border 
                Grid.Row="0"
                Padding="10" 
                HeightRequest="100" VerticalOptions="Start">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="auto, auto">
                    <Label 
                        Grid.Row="0" Grid.Column="0"
                        Text="{extensions:Translate ThemeText}" 
                        FontSize="18" 
                        FontAttributes="Bold"/>

                    <Label 
                        Text="{extensions:Translate ThemeContentText}" 
                        Grid.Row="1" Grid.Column="0"
                        VerticalOptions="Center"
                        FontSize="12" />

                    <Switch 
                        Grid.Row="1" Grid.Column="1"
                        IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                        ThumbColor="red" />
                </Grid>
            </Border>

            <Border 
                Grid.Row="1"
                Padding="10" 
                HeightRequest="100" VerticalOptions="Start">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label
                        Text="{extensions:Translate AboutPrivacyPolicyText}"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Button
                        Text="{extensions:Translate AboutOpenPrivacyPolicyText}"
                        Command="{Binding OpenPrivacyCommand}"
                        CornerRadius="8"
                        BackgroundColor="{StaticResource MyAccentBlue}"
                        TextColor="White"
                        HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Image Source="logo.svg" HeightRequest="100" HorizontalOptions="Center"/>
                <Label Text="{Binding VersionText}" HorizontalTextAlignment="Center" Opacity="0.7"/>

                <Label
                    Text="© 2026 | francisco-dev.cl"
                    HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenWebsiteCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Button
                    Text="{extensions:Translate AboutDonationText}"
                    Command="{Binding OpenDonationCommand}"
                    IsVisible="{Binding HasDonationUrl}"
                    Margin="20,6,20,0"
                    CornerRadius="8"
                    BackgroundColor="{StaticResource MyAccentBlue}"
                    TextColor="White" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
    
</ContentPage>
