<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NavajaSuiza_.NET10.Converters"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.DocumentReaderPage"
             Title="{extensions:Translate DocumentReaderText}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="10">

        <Button Grid.Row="0"
                Text="{extensions:Translate OpenDocumentButtonText}"
                Command="{Binding OpenDocumentCommand}" />

        <Label Grid.Row="1"
               Text="{Binding FileName}"
               FontAttributes="Bold"
               IsVisible="{Binding IsFileLoaded}" />

        <Label Grid.Row="2"
               Text="{Binding DetailText}"
               FontSize="13"
               IsVisible="{Binding IsFileLoaded}" />

        <Label Grid.Row="3"
               Text="{Binding HintText}"
               FontSize="15"
               IsVisible="{Binding IsFileLoaded, Converter={StaticResource InvertBool}}" />

        <Editor Grid.Row="4"
                Text="{Binding ContentText}"
                IsReadOnly="True"
                AutoSize="Disabled" />
    </Grid>
</ContentPage>