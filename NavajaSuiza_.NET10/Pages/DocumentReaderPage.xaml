<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:syncpdf="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             x:Class="NavajaSuiza_.NET10.Pages.DocumentReaderPage"
             Title="{extensions:Translate DocumentReaderText}">

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="10">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="5"
                             IsVisible="{Binding IsFileLoaded}">
            <Label Text="{Binding FileName}"
                   FontAttributes="Bold" />
            <Label Text="{Binding DetailText}"
                   FontSize="13" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <Editor Text="{Binding ContentText}"
                    IsReadOnly="True"
                    AutoSize="Disabled"
                    IsVisible="{Binding IsText}" />

            <syncgrid:SfDataGrid x:Name="CsvGrid"
                                 ItemsSource="{Binding CsvTable}"
                                 IsVisible="{Binding IsCsv}" />

            <syncpdf:SfPdfViewer x:Name="PdfViewer"
                                 DocumentSource="{Binding PdfDocumentStream}"
                                 IsVisible="{Binding IsPdf}" />
        </Grid>
    </Grid>
</ContentPage>
