<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NavajaSuiza_.NET10.Converters"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             xmlns:models="clr-namespace:NavajaSuiza.Core.Models;assembly=NavajaSuiza.Core"
             xmlns:selectors="clr-namespace:NavajaSuiza_.NET10.Selectors"
             x:Name="NotesPageRoot"
             x:Class="NavajaSuiza_.NET10.Pages.NotesPage"
             Title="{extensions:Translate NotesText}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <DataTemplate x:Key="NoteItemTemplate">
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource MyPrimaryLight}, Dark={StaticResource MyPrimaryDark}}"
                    Margin="15,3"
                    Padding="12,10">

                <Border.Shadow>
                    <Shadow Radius="10"
                            Opacity="0.15"
                            Brush="{StaticResource Black}"
                            Offset="0,2" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BindingContext.NavigateToEditNoteCommand, Source={x:Reference NotesPageRoot}}"
                                          CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding Title}"
                           FontAttributes="Bold"
                           FontSize="16"
                           LineBreakMode="TailTruncation" />

                    <Image Grid.Row="0" Grid.Column="1"
                           Source="icon_bell_ring.png"
                           WidthRequest="16"
                           HeightRequest="16"
                           IsVisible="{Binding HasReminder}"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{extensions:Translate NotesReminderSectionText}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding Content}"
                           FontSize="13"
                           Opacity="0.7"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />

                    <Button Grid.Row="0" Grid.Column="2"
                            Grid.RowSpan="2"
                            ImageSource="icon_delete.png"
                            BackgroundColor="{StaticResource MyOn}"
                            CornerRadius="8"
                            BorderWidth="0"
                            Padding="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{extensions:Translate NotesDeleteTitleText}"
                            Command="{Binding BindingContext.DeleteNoteCommand, Source={x:Reference NotesPageRoot}}"
                            CommandParameter="{Binding .}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TaskItemTemplate">
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource MyPrimaryLight}, Dark={StaticResource MyPrimaryDark}}"
                    Margin="15,3"
                    Padding="12,10">

                <Border.Shadow>
                    <Shadow Radius="10"
                            Opacity="0.15"
                            Brush="{StaticResource Black}"
                            Offset="0,2" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">

                    <!-- Encabezado: nombre + fecha (tap), recordatorio y eliminar -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.NavigateToEditTaskCommand, Source={x:Reference NotesPageRoot}}"
                                                      CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />

                            <Label Text="{Binding CreatedAtText}"
                                   FontSize="12"
                                   Opacity="0.6" />
                        </VerticalStackLayout>

                        <Image Grid.Column="1"
                               Source="icon_bell_ring.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               IsVisible="{Binding HasReminder}"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{extensions:Translate NotesReminderSectionText}" />

                        <Button Grid.Column="2"
                                ImageSource="icon_delete.png"
                                BackgroundColor="{StaticResource MyOn}"
                                CornerRadius="8"
                                BorderWidth="0"
                                Padding="8"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                SemanticProperties.Description="{extensions:Translate NotesDeleteTitleText}"
                                Command="{Binding BindingContext.DeleteTaskCommand, Source={x:Reference NotesPageRoot}}"
                                CommandParameter="{Binding .}" />
                    </Grid>

                    <!-- Ítems del grupo -->
                    <VerticalStackLayout Grid.Row="1"
                                         BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                    <Border Grid.Column="0"
                                            WidthRequest="15"
                                            HeightRequest="15"
                                            StrokeThickness="0"
                                            StrokeShape="Ellipse"
                                            VerticalOptions="Center"
                                            BackgroundColor="{StaticResource MyAccentBlue}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Importance}" Value="{x:Static models:TaskImportance.High}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MyOn}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Importance}" Value="{x:Static models:TaskImportance.Medium}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MyAccentOrange}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Importance}" Value="{x:Static models:TaskImportance.Low}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MyAccentBlue}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Scale="1"
                                              VerticalOptions="Center" />

                                    <Label Grid.Column="2"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:NotesItemTemplateSelector x:Key="NotesItemTemplateSelector"
                                             NoteTemplate="{StaticResource NoteItemTemplate}"
                                             TaskTemplate="{StaticResource TaskItemTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="0,10"
          RowSpacing="10">

        <!-- Acciones principales -->
        <Grid
            Grid.Row="0"
            Margin="15,0"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="{extensions:Translate NotesCreateNoteText}"
                Command="{Binding NavigateToNewNoteCommand}"
                Style="{StaticResource ActionButton}"
                BackgroundColor="{StaticResource MyAccentBlue}"
                FontSize="16"                
                HeightRequest="50"
                TextColor="White"
                SemanticProperties.Description="{extensions:Translate NotesNewDescriptionText}" />

            <Button
                Grid.Column="1"
                Text="{extensions:Translate NotesCreateTaskText}"
                Command="{Binding NavigateToNewTaskCommand}"
                Style="{StaticResource ActionButton}"
                BackgroundColor="{StaticResource MyAccentBlue}"
                FontSize="16"                
                HeightRequest="50"                
                TextColor="White"
                SemanticProperties.Description="{extensions:Translate NotesNewTaskDescriptionText}" />
        </Grid>

        <!-- Búsqueda -->
        <Border Grid.Row="1"
                  Margin="15,0"
                  Padding="8,0"
                  StrokeThickness="1"
                  Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                  StrokeShape="RoundRectangle 24"
                  BackgroundColor="{AppThemeBinding Light={StaticResource MyPrimaryLight}, Dark={StaticResource MyPrimaryDark}}">
            <SearchBar
                Text="{Binding SearchText}"
                Placeholder="{extensions:Translate NotesSearchPlaceholderText}"
                BackgroundColor="Transparent"
                FontSize="14" />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="*,*">

            <!-- Estado vacío -->
            <Label Grid.Row="0"
                   Grid.RowSpan="2"
                   Text="{extensions:Translate NotesEmptyText}"
                   IsVisible="{Binding HasNotes, Converter={StaticResource InvertedBoolConverter}}"
                   HorizontalTextAlignment="Center"
                   Opacity="0.6"
                   Padding="20,40" />

            <!-- Lista de notas y tareas -->
            <CollectionView Grid.Row="0"
                            Grid.RowSpan="2"
                            ItemsSource="{Binding Sections}"
                            IsGrouped="True"
                            IsVisible="{Binding HasNotes}"
                            ItemTemplate="{StaticResource NotesItemTemplateSelector}"
                            SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="15"
                               Opacity="0.75"
                               Margin="15,10,15,2" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
