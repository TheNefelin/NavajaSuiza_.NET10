<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NavajaSuiza_.NET10.Pages.PdfReaderPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
             xmlns:extensions="clr-namespace:NavajaSuiza_.NET10.Extensions"
             xmlns:viewModels="clr-namespace:NavajaSuiza.Core.ViewModels;assembly=NavajaSuiza.Core"
             x:DataType="viewModels:PdfReaderViewModel"
             Title="{extensions:Translate PdfReaderText}">

    <syncfusion:SfPdfViewer x:Name="PdfViewer"
                            DocumentSource="{Binding PdfDocumentStream}" />
</ContentPage>
